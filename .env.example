# PostgreSQL connection used by the app (Supabase: transaction pooler, port 6543)
DATABASE_URL="postgresql://user:password@localhost:5432/boiltech_email?schema=public"

# Direct/session connection used by Prisma migrations (Supabase: session pooler, port 5432).
# For a plain local PostgreSQL, set this to the same value as DATABASE_URL.
DIRECT_URL="postgresql://user:password@localhost:5432/boiltech_email?schema=public"

# Secret used to sign session cookies. Generate with: openssl rand -base64 32
AUTH_SECRET=

# Email provider (kept server-side only, never exposed to the browser)
# Which provider to use: "ses" or "brevo". If empty, Brevo is used when
# EMAIL_PROVIDER_API_KEY is set.
EMAIL_PROVIDER=
# Brevo API key (only needed when EMAIL_PROVIDER=brevo)
EMAIL_PROVIDER_API_KEY=
# Sender identity (both providers). The address/domain must be verified with the provider.
EMAIL_FROM_ADDRESS=
EMAIL_FROM_NAME=

# Amazon SES (only needed when EMAIL_PROVIDER=ses). Use an IAM user limited to ses:SendEmail.
AWS_SES_REGION=
AWS_SES_ACCESS_KEY_ID=
AWS_SES_SECRET_ACCESS_KEY=
# Optional SES configuration set (for event publishing / tracking)
AWS_SES_CONFIGURATION_SET=

# Public base URL of this app, used for absolute links in emails (unsubscribe).
# Defaults to http://localhost:3000. Must be https in production.
APP_URL=

# Secret for signing unsubscribe links. Falls back to AUTH_SECRET if empty.
# Generate with: openssl rand -base64 32
UNSUBSCRIBE_SECRET=

# --- Campaign sending safety -------------------------------------------------
# Global kill switch: campaigns are only sent when this is exactly "true".
EMAIL_SENDING_ENABLED=false
# Optional comma-separated emails/domains. When set, ONLY these recipients are
# actually sent to; everyone else is skipped. Use for safe test sends.
EMAIL_TEST_ALLOWLIST=
# Hard cap on recipients per campaign (default 100).
EMAIL_MAX_CAMPAIGN_RECIPIENTS=
# Throttle: max emails per second (app default 5). SES sandbox allows 1/sec, so keep 1
# until SES production access raises your MaxSendRate.
EMAIL_SEND_RATE_PER_SEC=1
# Recipients per batch (default 50).
EMAIL_BATCH_SIZE=
# Minutes a recipient may stay in SENDING before it is flagged FAILED for manual
# review (never re-sent automatically). Default 15.
EMAIL_STUCK_SENDING_MINUTES=

# Background sending. /api/cron/dispatch requires the header
#   Authorization: Bearer <CRON_SECRET>
# Vercel Cron sends this automatically when CRON_SECRET is set in the project.
# Generate with: openssl rand -base64 32
CRON_SECRET=

# Amazon SNS bounce/complaint webhook (/api/webhooks/ses). Optional: comma-separated
# topic ARNs to accept; when empty, any validly signed SNS message is accepted.
AWS_SNS_TOPIC_ARN=

# Used only by `npx prisma db seed` to create the first admin account.
# Change the password after first login.
SEED_ADMIN_NAME="BoilerTech Admin"
SEED_ADMIN_EMAIL="admin@boiltech.com"
SEED_ADMIN_PASSWORD=
